{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hikiyomi",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "observability": {
    "enabled": true
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hikiyomi-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
