{
  "name": "hikiyomi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "richmenu:build": "node scripts/setup-rich-menu.mjs --dry-run",
    "richmenu:setup": "node scripts/setup-rich-menu.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run richmenu:build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260728.1",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.114.0"
  }
}
