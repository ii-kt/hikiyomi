{
  "name": "hikiyomi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hikiyomi-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hikiyomi-db --remote",
    "richmenu:build": "node scripts/setup-rich-menu.mjs --dry-run",
    "richmenu:setup": "node scripts/setup-rich-menu.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250728.0",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.26.0"
  }
}
